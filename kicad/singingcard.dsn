    )
    (net "GND"
      (pins BT1-2 C1-2 C2-2 C3-2 C4-2 C5-2 C6-2 J2-2 R1-2 SW1-2 SW1-2 U1-10 U1-44 U2-4)
    )
    (net "VREG"
