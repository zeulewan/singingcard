    (class kicad_default "" "+3V" "GND" "VREG" "N$1" "N$2" "GPIO2_TAB" "GPIO0_LDR" "RESET" "CSB" "GPIO1_BTN" "SPI_MISO" "SPI_SCK" "SPI_CS" "SPI_MOSI"
