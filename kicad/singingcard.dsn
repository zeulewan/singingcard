      )
    )
    (component "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical"
      (place J2 135000 147000 front 0
      )
    )
    (component "singingcard:RES-TH_L5.1-W4.3-P3.40-D0.5"
      (place R1 112000 120000 front 0
      )
    )
    (component "Resistor_SMD:R_0603_1608Metric"
